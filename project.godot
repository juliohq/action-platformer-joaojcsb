; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Action Platformer"
config/version="1.0.0"
run/main_scene="uid://d3emagiip7vi6"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoloads/events.gd"
Globals="*res://autoloads/globals.gd"
AudioManager="*res://autoloads/audio_manager.gd"
Music="*res://autoloads/music.tscn"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=480
window/size/viewport_height=264
window/size/resizable=false
window/size/window_width_override=1280
window/size/window_height_override=704
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/content_manager/plugin.cfg", "res://addons/finite_state_machine/plugin.cfg", "res://addons/layout_helper/plugin.cfg", "res://addons/node_helper/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "red",
"res://assets/": "orange",
"res://autoloads/": "yellow",
"res://characters/": "green",
"res://enemies/": "teal",
"res://levels/": "blue",
"res://locales/": "purple",
"res://scenes/": "pink",
"res://shaders/": "red",
"res://tools/": "orange",
"res://ui/": "yellow"
}

[importer_defaults]

oggvorbisstr={
"bar_beats": 4,
"beat_count": 0,
"bpm": 0,
"loop": true,
"loop_offset": 0
}

